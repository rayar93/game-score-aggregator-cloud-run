# Cloud SQL (Postgres) connection.
# Local dev: run the Cloud SQL Auth Proxy, which listens on 127.0.0.1:5432
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=gamedb
DB_USER=gamedb_web
DB_PASSWORD=

# Twitch / IGDB API credentials (get these from https://dev.twitch.tv/console)
# Only necessary if you plan to run the ingestion scripts.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=